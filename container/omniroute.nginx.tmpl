server {
    listen 80;
    listen [::]:80;
    server_name __DOMAIN__;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name __DOMAIN__;

    ssl_certificate         /etc/ssl/__CERT_BASE_DOMAIN__/cert.pem;
    ssl_certificate_key     /etc/ssl/__CERT_BASE_DOMAIN__/privkey.pem;
    #__AOP_START__
    ssl_client_certificate  /etc/ssl/__CERT_BASE_DOMAIN__/cloudflare_ca.pem;
    ssl_verify_client       on;
    #__AOP_END__

    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;

    client_max_body_size 20m;

    # WebSocket live dashboard updates (Combo Studio). Served on the main PORT,
    # but needs Upgrade headers — the / location sets Connection "" for SSE cleanliness,
    # which would break the WS handshake, so it gets its own location.
    location /live-ws {
        proxy_pass http://127.0.0.1:__PORT__;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    location / {
        proxy_pass http://127.0.0.1:__PORT__;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # OmniRoute streaming chat completion uses SSE, do not buffer
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        chunked_transfer_encoding off;

        # Pure SSE, not WebSocket -- clear Connection so keepalive to upstream
        # does not get "stuck" and mix responses across requests
        proxy_set_header Connection "";
    }
}
