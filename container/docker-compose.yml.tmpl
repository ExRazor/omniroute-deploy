services:
  omniroute:
    image: docker.io/diegosouzapw/omniroute:latest
    ports:
      - "127.0.0.1:__PORT__:__PORT__"
    volumes:
      - "__HOST_DATA_DIR__:/app/data:Z"
    environment:
      - REDIS_URL=redis://redis:6379
    env_file:
      - __ENV_FILE__
    depends_on:
      redis:
        condition: service_healthy
    healthcheck:
      test: ["CMD-SHELL", "curl -fsS http://127.0.0.1:__PORT__/ || exit 1"]
      interval: 10s
      timeout: 3s
      retries: 5
      start_period: 20s
    stop_grace_period: 40s
    restart: always
    networks:
      - omniroute-net

  redis:
    image: docker.io/library/redis:8-alpine
    command: ["redis-server", "--save", "60", "1", "--loglevel", "warning"]
    volumes:
      - "__HOST_DATA_DIR__/redis:/data:Z"
    healthcheck:
      test: ["CMD", "redis-cli", "ping"]
      interval: 10s
      timeout: 3s
      retries: 5
      start_period: 5s
    stop_grace_period: 40s
    restart: always
    networks:
      - omniroute-net

networks:
  omniroute-net:
