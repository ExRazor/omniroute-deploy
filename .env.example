# --- Secrets, leave empty -> auto-generated on deploy ---
JWT_SECRET=
API_KEY_SECRET=

# MUST be set manually
INITIAL_PASSWORD=ganti-password-login-pertama

# SQLite at-rest DB encryption key. Empty = OmniRoute bootstrap auto-generates
# & stores it to <HOST_DATA_DIR>/server.env on first boot. Set manually for
# reproducible/immutable installs (e.g. openssl rand -hex 32).
# ⚠️ BACKUP: storage.sqlite is encrypted with this key. If the key is lost
# (deleting <HOST_DATA_DIR> without a server.env backup, or .env loss when set
# manually), the DB CANNOT be decrypted -> data is gone. Back up the ENTIRE
# <HOST_DATA_DIR>/ folder (storage.sqlite + server.env + db_backups/), not just
# storage.sqlite alone.
STORAGE_ENCRYPTION_KEY=

# Data path INSIDE the container -- do not change
DATA_DIR=/app/data

PORT=20128
# Data path on the HOST, empty = use ./data inside this project folder
HOST_DATA_DIR=

REQUIRE_API_KEY=true

# Next.js environment mode
NODE_ENV=production

# Container runtime -- set automatically by deploy.sh based on the detected engine (podman/docker).
# The image entrypoint uses this to pick the correct permission-fix instructions.
CONTAINER_HOST=podman

# --- Domain & SSL (used by deploy.sh to generate the nginx config) ---
# Subdomain used for OmniRoute, change to match your domain
DOMAIN=or.example.com
# Base domain where the Cloudflare cert is stored: /etc/ssl/<CERT_BASE_DOMAIN>/{cert.pem,privkey.pem,cloudflare_ca.pem}
# Empty = auto-detect the last 2 labels of DOMAIN (e.g. or.example.com -> example.com)
# Set manually if your TLD has 2 parts, e.g. domain.ac.id / domain.co.id (auto-detect would wrongly pick "ac.id"/"co.id")
CERT_BASE_DOMAIN=

# Require a client cert from Cloudflare (mTLS / Authenticated Origin Pulls).
# If true: you MUST first enable it in the Cloudflare dashboard -> SSL/TLS -> Origin Server ->
# Authenticated Origin Pulls -> Global -> On (and SSL mode must be Full/Full strict),
# plus cloudflare_ca.pem must exist at /etc/ssl/<CERT_BASE_DOMAIN>/
# If not enabled in Cloudflare yet, leave this false (default) to avoid 400 Bad Request.
CF_AUTH_ORIGIN_PULLS=false

# --- Live WebSocket (Combo Studio live dashboard updates) ---
# Live-WS server port in the container (upstream default 20132).
# The rest (LIVE_WS_HOST, LIVE_WS_ALLOWED_ORIGINS, NEXT_PUBLIC_LIVE_WS_PUBLIC_URL)
# is auto-filled by deploy.sh from DOMAIN on the first run.
LIVE_WS_PORT=20132
