# --- Secrets, leave empty -> auto-generated on deploy ---
JWT_SECRET=
API_KEY_SECRET=
# WebSocket bridge shared secret (dashboard live view). Empty = auto-generated on deploy.
OMNIROUTE_WS_BRIDGE_SECRET=

# MUST be set manually
INITIAL_PASSWORD=ganti-password-login-pertama

# SQLite at-rest DB encryption key. Empty = OmniRoute bootstrap auto-generates
# & stores it to <HOST_DATA_DIR>/server.env on first boot. Set manually for
# reproducible/immutable installs (e.g. openssl rand -hex 32).
# ⚠️ BACKUP: storage.sqlite is encrypted with this key. If the key is lost
# (deleting <HOST_DATA_DIR> without a server.env backup, or .env loss when set
# manually), the DB CANNOT be decrypted -> data is gone. Back up the ENTIRE
# <HOST_DATA_DIR>/ folder (storage.sqlite + server.env + db_backups/), not just
# storage.sqlite alone.
STORAGE_ENCRYPTION_KEY=

# Data path INSIDE the container -- do not change
DATA_DIR=/app/data

PORT=20128
# Data path on the HOST, empty = use ./data inside this project folder
HOST_DATA_DIR=

# Redis sidecar (rate limiter / shared cache backend).
# The compose/quadlet templates inject redis://redis:6379 directly; set this only
# to point OmniRoute at an external Redis instead of the bundled sidecar.
REDIS_URL=redis://redis:6379

# Security defaults for HTTPS-behind-nginx.
# AUTH_COOKIE_SECURE must be true so session cookies aren't sent over plain HTTP.
# REQUIRE_API_KEY gates all /v1/* proxy calls behind an API key.
AUTH_COOKIE_SECURE=true
REQUIRE_API_KEY=true

# Public origin for OAuth callbacks, dashboard links, and the live-WS origin allow-list.
# Auto-set from DOMAIN on first deploy if empty.
NEXT_PUBLIC_BASE_URL=
# Live-WS origin allow-list — browser Origin header must match or the WS is rejected.
# Auto-set from DOMAIN on first deploy if empty.
LIVE_WS_ALLOWED_ORIGINS=
# Public WS URL for Combo Studio live view. The image's build-time default hardcodes
# :20132 (unpublished loopback); this overrides it at runtime via the WS handshake.
# Auto-set from DOMAIN on first deploy if empty.
NEXT_PUBLIC_LIVE_WS_PUBLIC_URL=

# Next.js environment mode
NODE_ENV=production

# Container runtime -- set automatically by deploy.sh based on the detected engine (podman/docker).
# The image entrypoint uses this to pick the correct permission-fix instructions.
CONTAINER_HOST=podman

# --- Domain & SSL (used by deploy.sh to generate the nginx config) ---
# Subdomain used for OmniRoute, change to match your domain
DOMAIN=or.example.com
# Base domain where the Cloudflare cert is stored: /etc/ssl/<CERT_BASE_DOMAIN>/{cert.pem,privkey.pem,cloudflare_ca.pem}
# Empty = auto-detect the last 2 labels of DOMAIN (e.g. or.example.com -> example.com)
# Set manually if your TLD has 2 parts, e.g. domain.ac.id / domain.co.id (auto-detect would wrongly pick "ac.id"/"co.id")
CERT_BASE_DOMAIN=

# Require a client cert from Cloudflare (mTLS / Authenticated Origin Pulls).
# If true: you MUST first enable it in the Cloudflare dashboard -> SSL/TLS -> Origin Server ->
# Authenticated Origin Pulls -> Global -> On (and SSL mode must be Full/Full strict),
# plus cloudflare_ca.pem must exist at /etc/ssl/<CERT_BASE_DOMAIN>/
# If not enabled in Cloudflare yet, leave this false (default) to avoid 400 Bad Request.
CF_AUTH_ORIGIN_PULLS=false

# --- Backup & restore (backup/*.sh) ---
# Filename prefix for backup archives (e.g. omniroute_20260807.7z).
# Change only if you push several OmniRoute deploys to one rclone remote.
PREFIX=omniroute
# rclone remote name used for uploads (must exist in `rclone listremotes`).
RCLONE_CONFIG_NAME=omniroute
# Path inside the remote, default "/" = remote root.
RCLONE_REMOTE_PATH=/
# Local retention in days: older local backups are deleted before a new one.
BACKUP_RETENTION_LOCAL_DAYS=3
# Remote retention in days: older remote backups are deleted after upload.
BACKUP_RETENTION_REMOTE_DAYS=30
# Cron schedule (crontab format). Empty = interactive prompt in install_cron.sh.
BACKUP_CRON_SCHEDULE=0 0 * * *
# Cron backup mode: "remote" = local + rclone upload, "local" = local only. Empty = interactive prompt.
BACKUP_CRON_MODE=remote

